rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public single-doc read for the live counter (no auth required; request.auth is null for anonymous web clients)
    match /stats/waitlist {
      allow get: if true;
    }
    // Public single-doc read for the ambient lamp state (state + first name only — see
    // functions/src/lamp.ts's mirrorActiveCallToLamp for what's actually written here).
    // Only the Admin SDK (the mirror Function) may write it; no client write, ever (T-03-07).
    match /lamp/current {
      allow get: if true;
      allow write: if false;
    }
    // Public single-doc read for a family member's realtime verification prompt (VER-02).
    // Only the Admin SDK (mirrorActiveCallToLamp) may write it; no client write, ever.
    match /prompts/{memberId} {
      allow get: if true;
      allow write: if false;
    }
    // Public read of the household's live/history call feed (DASH-01/02) — the full D-05
    // CallDoc shape mirrored out of the closed calls/{id} collection. Only the Admin SDK
    // (mirrorActiveCallToLamp) may write it; no client write, ever.
    match /households/{householdId}/feed/{callId} {
      allow get: if true;
      allow list: if true;
      allow write: if false;
    }
    // Phase 6 (06-H): public read of the demo household's family alerts (joystick /
    // raiseFamilyAlert) so the /app W7 alert card renders for anonymous web clients.
    // Scoped to the single `demo` household like the rest of the public mirror docs.
    // Only the Admin SDK writes (raiseFamilyAlert / resetDemo); no client write, ever.
    match /households/demo/alerts/{alertId} {
      allow get: if true;
      allow list: if true;
      allow write: if false;
    }
    // Phase 6 (D-12): the Mac bridge's heartbeat doc, read by the web OperatorBar.
    // The bridge runs with the public web config and NO auth, so the write is open to anyone
    // but locked to exactly this shape -- demo-grade risk accepted: the worst case is a spoofed
    // status row on the operator screen, nothing the demo flow depends on.
    match /status/bridge {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['piOk', 'piState', 'hueReachable', 'hueTotal', 'lastBeat', 'version'])
        && request.resource.data.keys().hasAll(['piOk', 'piState', 'hueReachable', 'hueTotal', 'lastBeat', 'version'])
        && request.resource.data.lastBeat is number
        && request.resource.data.piOk is bool
        && request.resource.data.hueReachable is number
        && request.resource.data.hueTotal is number
        && (request.resource.data.piState == null || (request.resource.data.piState is string && request.resource.data.piState.size() < 32))
        && request.resource.data.version is string && request.resource.data.version.size() < 32;
    }
    // Phase 6 (D-10): "Reset done" marker, written only by resetDemo (Admin SDK).
    match /status/demo {
      allow get: if true;
      allow write: if false;
    }
    // Everything else closed to clients; Admin SDK in Functions bypasses rules
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
